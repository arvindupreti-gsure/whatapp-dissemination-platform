/* WhatsApp Dissemination & Analytics Platform: proof of concept UI
   Gsure Technologies Private Limited */
'use strict';

// ------------------------------------------------------------------ api
const api = {
  async req(method, url, body, isForm) {
    const opt = { method, headers: {}, credentials: 'same-origin' };
    if (body !== undefined) {
      if (isForm) { opt.body = body; }
      else { opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(body); }
    }
    const r = await fetch(url, opt);
    if (r.status === 401) { showLogin(); throw new Error('Session expired'); }
    const ct = r.headers.get('content-type') || '';
    const data = ct.includes('json') ? await r.json() : await r.text();
    if (!r.ok) throw new Error((data && data.detail) || r.statusText);
    return data;
  },
  get(u) { return this.req('GET', u); },
  post(u, b) { return this.req('POST', u, b === undefined ? {} : b); },
  patch(u, b) { return this.req('PATCH', u, b); },
  del(u) { return this.req('DELETE', u); },
  form(u, fd) { return this.req('POST', u, fd, true); },
};

const S = { user: null, sys: null, view: 'dashboard', campaign: null, timers: [] };
const $ = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g,
  c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const n = (v) => (v == null ? '0' : Number(v).toLocaleString('en-IN'));
const pct = (v) => (v == null ? '0' : Number(v).toFixed(1)) + '%';
const clearTimers = () => { S.timers.forEach(clearInterval); S.timers = []; };
const every = (ms, fn) => { S.timers.push(setInterval(fn, ms)); };
const when = (iso) => iso ? new Date(iso).toLocaleString('en-IN',
  { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—';
const can = (p) => S.user && S.user.permissions.includes(p);

// ----------------------------------------------------------------- chart
// Colours come from CSS custom properties so light and dark stay in one place.
const css = (name) => getComputedStyle(document.documentElement)
  .getPropertyValue(name).trim();
const SERIES = () => [css('--series-1'), css('--series-2'), css('--series-3')];

const tipEl = () => $('#tip');
function showTip(html, x, y) {
  const t = tipEl();
  t.innerHTML = html;
  t.classList.add('on');
  const r = t.getBoundingClientRect();
  let left = x + 14, top = y - r.height - 10;
  if (left + r.width > innerWidth - 8) left = x - r.width - 14;
  if (top < 8) top = y + 16;
  t.style.left = left + 'px'; t.style.top = top + 'px';
}
const hideTip = () => tipEl().classList.remove('on');

function niceMax(v) {
  if (v <= 5) return 5;
  const p = Math.pow(10, Math.floor(Math.log10(v)));
  return Math.ceil(v / p * 2) / 2 * p;
}

/* Multi-series line chart with crosshair and tooltip.
   Direct labels on the final point of each series (selective), legend always
   present for >= 2 series, and a table view, which is the relief the palette
   validator requires for the aqua slot on a light surface. */
function lineChart(el, opts) {
  const { labels, series, yLabel } = opts;
  const W = Math.max(520, el.clientWidth || 700), H = opts.height || 236;
  const m = { t: 14, r: 76, b: 26, l: 46 };
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const cols = SERIES();
  const max = niceMax(Math.max(1, ...series.flatMap(s => s.values)));
  const X = i => m.l + (labels.length < 2 ? iw / 2 : (iw * i) / (labels.length - 1));
  const Y = v => m.t + ih - (v / max) * ih;

  const ticks = [0, .25, .5, .75, 1].map(f => Math.round(max * f));
  let g = '';
  ticks.forEach(tv => {
    g += `<line class="grid-line" x1="${m.l}" y1="${Y(tv)}" x2="${m.l + iw}" y2="${Y(tv)}"/>` +
         `<text x="${m.l - 8}" y="${Y(tv) + 3.5}" text-anchor="end">${n(tv)}</text>`;
  });
  g += `<line class="axis-line" x1="${m.l}" y1="${m.t + ih}" x2="${m.l + iw}" y2="${m.t + ih}"/>`;

  const step = Math.max(1, Math.ceil(labels.length / 7));
  labels.forEach((lb, i) => {
    if (i % step && i !== labels.length - 1) return;
    g += `<text x="${X(i)}" y="${H - 7}" text-anchor="middle">${esc(lb)}</text>`;
  });

  series.forEach((s, si) => {
    const c = cols[si % cols.length];
    const d = s.values.map((v, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
    g += `<path class="series-line" d="${d}" stroke="${c}"/>`;
    const li = s.values.length - 1;
    g += `<circle class="dot" cx="${X(li)}" cy="${Y(s.values[li])}" r="4.5" fill="${c}"/>`;
    // direct label, selective: only the series end
    g += `<text class="lbl" x="${m.l + iw + 9}" y="${Y(s.values[li]) + 3.5}">${esc(s.name)}</text>`;
  });

  g += `<line id="cross" class="axis-line" y1="${m.t}" y2="${m.t + ih}" style="opacity:0"/>`;
  el.innerHTML =
    `<ul class="legend">${series.map((s, i) =>
      `<li><span class="swatch" style="background:${cols[i % cols.length]}"></span>${esc(s.name)}</li>`).join('')}</ul>
     <svg class="chart" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet"
          role="img" aria-label="${esc(yLabel || 'Chart')}">${g}
       <rect x="${m.l}" y="${m.t}" width="${iw}" height="${ih}" fill="transparent" id="hit"/>
     </svg>
     <div class="chart-foot">
       <span style="font-size:11px;color:var(--text-muted)">${esc(yLabel || '')}</span>
       <button class="btn sm" data-tbl>Table view</button>
     </div>
     <div class="tbl-wrap hidden" data-tblwrap style="margin-top:10px">
       <table><thead><tr><th>Point</th>${series.map(s => `<th class="num">${esc(s.name)}</th>`).join('')}</tr></thead>
       <tbody>${labels.map((lb, i) =>
         `<tr><td>${esc(lb)}</td>${series.map(s => `<td class="num">${n(s.values[i])}</td>`).join('')}</tr>`).join('')}
       </tbody></table>
     </div>`;

  const svg = $('svg', el), cross = $('#cross', svg);
  $('[data-tbl]', el).onclick = (e) => {
    const w = $('[data-tblwrap]', el);
    w.classList.toggle('hidden');
    e.target.textContent = w.classList.contains('hidden') ? 'Table view' : 'Hide table';
  };
  $('#hit', svg).addEventListener('mousemove', (ev) => {
    const b = svg.getBoundingClientRect();
    const sx = (ev.clientX - b.left) * (W / b.width);
    let i = Math.round(((sx - m.l) / iw) * (labels.length - 1));
    i = Math.max(0, Math.min(labels.length - 1, i));
    cross.setAttribute('x1', X(i)); cross.setAttribute('x2', X(i));
    cross.style.opacity = .55;
    showTip(`<div class="t-title">${esc(labels[i])}</div>` + series.map((s, si) =>
      `<div class="t-row"><span class="k"><span class="swatch" style="width:9px;height:9px;border-radius:3px;background:${cols[si % cols.length]}"></span>${esc(s.name)}</span><span class="v">${n(s.values[i])}</span></div>`).join(''),
      ev.clientX, ev.clientY);
  });
  $('#hit', svg).addEventListener('mouseleave', () => { hideTip(); cross.style.opacity = 0; });
}

/* Grouped bars: 4px rounded data-ends anchored to the baseline, 2px gap
   between adjacent bars, direct value labels, legend, hover tooltip. */
function barChart(el, opts) {
  const { groups, series, yLabel } = opts;
  const W = Math.max(480, el.clientWidth || 640), H = opts.height || 224;
  const m = { t: 16, r: 14, b: 30, l: 46 };
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const cols = SERIES();
  const max = niceMax(Math.max(1, ...series.flatMap(s => s.values)));
  const Y = v => m.t + ih - (v / max) * ih;
  const gw = iw / groups.length, bw = Math.min(38, (gw - 14) / series.length - 2);

  let g = '';
  [0, .5, 1].map(f => Math.round(max * f)).forEach(tv => {
    g += `<line class="grid-line" x1="${m.l}" y1="${Y(tv)}" x2="${m.l + iw}" y2="${Y(tv)}"/>` +
         `<text x="${m.l - 8}" y="${Y(tv) + 3.5}" text-anchor="end">${n(tv)}</text>`;
  });
  g += `<line class="axis-line" x1="${m.l}" y1="${m.t + ih}" x2="${m.l + iw}" y2="${m.t + ih}"/>`;

  groups.forEach((gl, gi) => {
    const cx = m.l + gw * gi + gw / 2;
    const total = series.length * bw + (series.length - 1) * 2;
    series.forEach((s, si) => {
      const v = s.values[gi] || 0;
      const x = cx - total / 2 + si * (bw + 2);
      const h = Math.max(1, m.t + ih - Y(v));
      g += `<rect x="${x}" y="${Y(v)}" width="${bw}" height="${h}" rx="4" ry="4"
              fill="${cols[si % cols.length]}" data-g="${gi}" data-s="${si}" class="bar"/>`;
      if (v > 0) g += `<text class="lbl" x="${x + bw / 2}" y="${Y(v) - 5}" text-anchor="middle">${n(v)}</text>`;
    });
    g += `<text x="${cx}" y="${H - 9}" text-anchor="middle">${esc(gl)}</text>`;
  });

  el.innerHTML =
    `<ul class="legend">${series.map((s, i) =>
      `<li><span class="swatch" style="background:${cols[i % cols.length]}"></span>${esc(s.name)}</li>`).join('')}</ul>
     <svg class="chart" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet"
          role="img" aria-label="${esc(yLabel || 'Chart')}">${g}</svg>
     <div class="chart-foot"><span style="font-size:11px;color:var(--text-muted)">${esc(yLabel || '')}</span></div>`;

  $$('.bar', el).forEach(b => {
    b.addEventListener('mousemove', ev => {
      const gi = +b.dataset.g, si = +b.dataset.s;
      showTip(`<div class="t-title">${esc(groups[gi])}</div>
        <div class="t-row"><span class="k"><span class="swatch" style="width:9px;height:9px;border-radius:3px;background:${cols[si % cols.length]}"></span>${esc(series[si].name)}</span><span class="v">${n(series[si].values[gi])}</span></div>`,
        ev.clientX, ev.clientY);
    });
    b.addEventListener('mouseleave', hideTip);
  });
}

/* Delivery outcome is STATUS data, not a series, so it uses the reserved
   status palette and every segment carries an icon and a label. */
function statusBar(el, parts) {
  const total = parts.reduce((a, p) => a + p.value, 0) || 1;
  el.innerHTML =
    `<div class="statusbar">${parts.map(p =>
      `<span style="width:${(p.value / total * 100).toFixed(2)}%;background:${p.color}"
             title="${esc(p.label)}: ${n(p.value)}"></span>`).join('')}</div>
     <div class="status-key">${parts.map(p =>
      `<div><span class="dot-k" style="background:${p.color}"></span>
         <span>${esc(p.icon)} ${esc(p.label)}</span>
         <strong style="font-variant-numeric:tabular-nums">${n(p.value)}</strong>
         <span style="color:var(--text-muted)">${(p.value / total * 100).toFixed(1)}%</span></div>`).join('')}</div>`;
}

// ----------------------------------------------------------------- modal
function modal(title, bodyHtml, footHtml) {
  $('#modal').innerHTML =
    `<header><h2>${esc(title)}</h2><div class="spacer"></div>
       <button class="btn sm" data-x>Close</button></header>
     <div class="body">${bodyHtml}</div>
     ${footHtml ? `<footer>${footHtml}</footer>` : ''}`;
  $('#modalBg').classList.add('on');
  $('[data-x]', $('#modal')).onclick = closeModal;
  return $('#modal');
}
const closeModal = () => $('#modalBg').classList.remove('on');
$('#modalBg').addEventListener('click', e => { if (e.target.id === 'modalBg') closeModal(); });

function toast(msg, bad) {
  const d = document.createElement('div');
  d.style.cssText = `position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:200;
    background:var(--surface-1);border:1px solid ${bad ? 'var(--critical)' : 'var(--rule)'};
    color:${bad ? 'var(--critical)' : 'var(--text-primary)'};padding:10px 16px;border-radius:9px;
    box-shadow:var(--shadow);font-size:13px;font-weight:600`;
  d.textContent = msg;
  document.body.appendChild(d);
  setTimeout(() => d.remove(), 3200);
}

// ----------------------------------------------------------------- views
const VIEWS = {};

VIEWS.dashboard = {
  title: 'Dashboard', sub: 'Portfolio position across the group network',
  async render(c) {
    const d = await api.get('/api/dashboard');
    const s = d.summary;
    c.innerHTML = `
      <div class="grid g4" style="margin-bottom:14px">
        ${tile('Groups under management', n(s.groups_total), n(s.groups_active) + ' active')}
        ${tile('Campaigns', n(s.campaigns_total), s.campaigns_running + ' running or paused')}
        ${tile('Messages despatched', n(s.messages_total), 'across all campaigns')}
        ${tile('Reach', pct(s.reach_pct), n(s.groups_reached) + ' groups confirmed')}
      </div>
      <div class="grid g21">
        <div class="card">
          <h2>Delivery outcome across all campaigns</h2>
          <div class="cap">Status data, so it uses the reserved status palette. Every segment is labelled.</div>
          <div id="statusWrap"></div>
          <div class="note" style="margin-top:14px">
            <strong>M1</strong> reached counts a group once the platform has confirmation the message arrived.
            <strong>M3</strong> pending is derived from the gap between a sent and a delivered status, which is
            the one metric with no dedicated field in Meta's documentation.
          </div>
        </div>
        <div class="card">
          <h2>Despatch governor</h2>
          <div class="cap">Rate limiting protects the sending account</div>
          <dl class="kv">
            <dt>Nominal rate</dt><dd>${d.rate.rate_per_sec} messages/second</dd>
            <dt>Effective now</dt><dd>${d.rate.effective_rate} /s <span class="pill">warm-up ramp</span></dd>
            <dt>Randomised jitter</dt><dd>&plusmn;${Math.round(d.rate.jitter * 100)}%</dd>
            <dt>Sent today</dt><dd>${n(d.daily.sent_today)} of ${n(d.daily.ceiling)} ceiling</dd>
          </dl>
          ${can('settings.write') ? `<div class="btn-row" style="margin-top:12px">
            <button class="btn sm" id="rateBtn">Adjust rate</button></div>` : ''}
        </div>
      </div>
      <div class="card" style="margin-top:14px">
        <h2>Recent campaigns</h2>
        <div class="cap">Most recent first</div>
        <div class="tbl-wrap"><table>
          <thead><tr><th>Code</th><th>Campaign</th><th>Status</th><th class="num">Targets</th><th>Created</th><th></th></tr></thead>
          <tbody>${d.recent.length ? d.recent.map(r => `<tr>
            <td class="mono">${esc(r.code)}</td><td>${esc(r.name)}</td>
            <td>${statusPill(r.status)}</td><td class="num">${n(r.targets)}</td>
            <td class="nowrap">${when(r.created_at)}</td>
            <td class="right"><button class="btn sm" data-open="${r.id}">Open</button></td></tr>`).join('')
            : '<tr><td colspan="6" class="empty">No campaigns yet. Create one from the Campaigns view.</td></tr>'}
          </tbody></table></div>
      </div>`;

    statusBar($('#statusWrap', c), [
      { label: 'Reached', value: s.groups_reached, color: css('--good'), icon: '✓' },
      { label: 'Pending', value: s.pending, color: css('--warning'), icon: '○' },
      { label: 'Failed', value: s.failures, color: css('--critical'), icon: '✕' },
    ]);
    $$('[data-open]', c).forEach(b => b.onclick = () => openCampaign(+b.dataset.open));
    const rb = $('#rateBtn', c);
    if (rb) rb.onclick = () => rateModal(d.rate);
  }
};

const tile = (label, value, foot) =>
  `<div class="card tile"><div class="label">${esc(label)}</div>
   <div class="value">${value}</div><div class="foot">${esc(foot || '')}</div></div>`;

function statusPill(st) {
  const map = {
    completed: ['good', '✓ completed'], running: ['info', '▸ running'],
    partially_failed: ['warn', '⚠ partial'], failed: ['crit', '✕ failed'],
    paused: ['warn', '‖ paused'], scheduled: ['info', '◷ scheduled'],
    draft: ['', '○ draft'], cancelled: ['crit', '✕ cancelled'],
  };
  const [k, t] = map[st] || ['', st];
  return `<span class="pill ${k}">${t}</span>`;
}

function rateModal(rate) {
  modal('Adjust despatch rate', `
    <div class="note warn" style="margin-bottom:14px">Rate governance is the primary
      protection for the sending account. Raising it increases the account restriction
      risk recorded as R1 in the proposal.</div>
    <div class="field"><label>Messages per second</label>
      <input id="rr" type="number" min="0.5" step="0.5" value="${rate.rate_per_sec}"></div>
    <div class="field"><label>Randomised jitter (0 to 0.9)</label>
      <input id="rj" type="number" min="0" max="0.9" step="0.05" value="${rate.jitter}"></div>`,
    `<button class="btn" data-x2>Cancel</button><button class="btn primary" id="rsave">Save</button>`);
  $('[data-x2]').onclick = closeModal;
  $('#rsave').onclick = async () => {
    await api.post('/api/settings/rate', { rate: +$('#rr').value, jitter: +$('#rj').value });
    closeModal(); toast('Rate updated'); go('dashboard');
  };
}

// ---------------------------------------------------------------- groups
VIEWS.groups = {
  title: 'Groups', sub: 'The group network under structured management',
  state: { page: 1, q: '', category: '', folder: '', tag: '' },
  async render(c) {
    const f = await api.get('/api/groups/facets');
    const st = this.state;
    c.innerHTML = `
      <div class="toolbar">
        <input type="search" id="gq" placeholder="Search name, id or region" value="${esc(st.q)}">
        <select id="gcat"><option value="">All categories</option>
          ${f.categories.map(x => `<option ${st.category === x.value ? 'selected' : ''} value="${esc(x.value)}">${esc(x.value)} (${x.count})</option>`).join('')}</select>
        <select id="gfold"><option value="">All folders</option>
          ${f.folders.map(x => `<option ${st.folder === x.value ? 'selected' : ''} value="${esc(x.value)}">${esc(x.value)} (${x.count})</option>`).join('')}</select>
        <select id="gtag"><option value="">All tags</option>
          ${f.tags.map(x => `<option ${st.tag === x.value ? 'selected' : ''} value="${esc(x.value)}">${esc(x.value)} (${x.count})</option>`).join('')}</select>
        <div class="spacer"></div>
        ${can('group.write') ? '<button class="btn sm" id="impBtn">Import CSV</button>' : ''}
        ${can('report.export') ? '<a class="btn sm" href="/api/reports/groups.xlsx">Export Excel</a>' : ''}
      </div>
      <div class="card"><div id="gtbl"><div class="empty"><span class="spin"></span></div></div></div>`;

    const load = async () => {
      const p = new URLSearchParams({ page: st.page, size: 50, q: st.q, category: st.category, folder: st.folder, tag: st.tag });
      const d = await api.get('/api/groups?' + p);
      const pages = Math.max(1, Math.ceil(d.total / d.size));
      $('#gtbl', c).innerHTML = `
        <div style="display:flex;align-items:center;margin-bottom:10px">
          <div style="font-size:12.5px;color:var(--text-secondary)">
            <strong>${n(d.total)}</strong> groups match &middot; page ${d.page} of ${n(pages)}</div>
          <div class="spacer"></div>
          <div class="btn-row">
            <button class="btn sm" ${d.page <= 1 ? 'disabled' : ''} id="gprev">Previous</button>
            <button class="btn sm" ${d.page >= pages ? 'disabled' : ''} id="gnext">Next</button></div>
        </div>
        <div class="tbl-wrap"><table>
          <thead><tr><th>Group</th><th>Category</th><th>Folder</th><th>Tags</th>
            <th class="num">Members</th><th>Region</th><th>State</th><th class="mono">WhatsApp id</th></tr></thead>
          <tbody>${d.items.map(g => `<tr>
            <td>${esc(g.name)}</td><td>${esc(g.category)}</td><td>${esc(g.folder)}</td>
            <td>${g.tags.map(t => `<span class="chip">${esc(t)}</span>`).join('')}</td>
            <td class="num">${n(g.member_count)}</td><td>${esc(g.region)}</td>
            <td>${g.active ? '<span class="pill good">✓ active</span>' : '<span class="pill">○ inactive</span>'}</td>
            <td class="mono">${esc(g.wa_group_id)}</td></tr>`).join('')}</tbody></table></div>`;
      $('#gprev', c).onclick = () => { st.page--; load(); };
      $('#gnext', c).onclick = () => { st.page++; load(); };
    };
    let deb;
    $('#gq', c).oninput = e => { clearTimeout(deb); deb = setTimeout(() => { st.q = e.target.value; st.page = 1; load(); }, 280); };
    ['gcat:category', 'gfold:folder', 'gtag:tag'].forEach(pair => {
      const [id, key] = pair.split(':');
      $('#' + id, c).onchange = e => { st[key] = e.target.value; st.page = 1; load(); };
    });
    const ib = $('#impBtn', c);
    if (ib) ib.onclick = importModal;
    load();
  }
};

function importModal() {
  modal('Import groups from CSV', `
    <p style="font-size:12.5px;color:var(--text-secondary);margin-top:0">
      Columns: <span class="mono">wa_group_id, name, category, folder, tags, member_count, region</span>.
      Tags are separated by a pipe. Existing rows are matched on the WhatsApp group id and updated.</p>
    <div class="field"><label>CSV file</label><input type="file" id="csvf" accept=".csv,text/csv"></div>
    <div class="note">A real import from the client's own network is done from the
      Channels view: only the linked device route can enumerate pre-existing groups.</div>`,
    `<button class="btn" data-x3>Cancel</button><button class="btn primary" id="doImp">Import</button>`);
  $('[data-x3]').onclick = closeModal;
  $('#doImp').onclick = async () => {
    const f = $('#csvf').files[0];
    if (!f) return toast('Choose a file first', true);
    const fd = new FormData(); fd.append('file', f);
    try {
      const r = await api.form('/api/groups/import', fd);
      closeModal(); toast(`Added ${r.added}, updated ${r.updated}`); go('groups');
    } catch (e) { toast(e.message, true); }
  };
}

// ------------------------------------------------------------- campaigns
VIEWS.campaigns = {
  title: 'Campaigns', sub: 'Compose, target, schedule and execute',
  async render(c) {
    const d = await api.get('/api/campaigns?size=50');
    c.innerHTML = `
      <div class="toolbar">
        <div style="font-size:12.5px;color:var(--text-secondary)"><strong>${n(d.total)}</strong> campaigns</div>
        <div class="spacer"></div>
        ${can('campaign.write') ? '<button class="btn primary" id="newC">New campaign</button>' : ''}
      </div>
      <div class="card"><div class="tbl-wrap"><table>
        <thead><tr><th>Code</th><th>Campaign</th><th>Status</th><th>Channel</th>
          <th class="num">Targets</th><th class="num">Reached</th><th class="num">Failed</th>
          <th class="num">Pending</th><th>Created</th><th></th></tr></thead>
        <tbody>${d.items.length ? d.items.map(r => `<tr>
          <td class="mono">${esc(r.code)}</td><td>${esc(r.name)}</td>
          <td>${statusPill(r.status)}</td><td><span class="pill">${esc(r.channel)}</span></td>
          <td class="num">${n(r.targets)}</td><td class="num">${n(r.reached)}</td>
          <td class="num">${n(r.failed)}</td><td class="num">${n(r.pending)}</td>
          <td class="nowrap">${when(r.created_at)}</td>
          <td class="right"><button class="btn sm" data-open="${r.id}">Open</button></td></tr>`).join('')
          : '<tr><td colspan="10" class="empty">No campaigns yet.</td></tr>'}
        </tbody></table></div></div>`;
    $$('[data-open]', c).forEach(b => b.onclick = () => openCampaign(+b.dataset.open));
    const nb = $('#newC', c);
    if (nb) nb.onclick = newCampaign;
  }
};

async function newCampaign() {
  const [facets, lists, tpls, chans] = await Promise.all([
    api.get('/api/groups/facets'), api.get('/api/lists'),
    api.get('/api/templates'), api.get('/api/channels')]);
  modal('New campaign', `
    <div class="steps">
      <div class="step on">1. Compose</div><div class="step">2. Target</div>
      <div class="step">3. Schedule</div></div>
    <div class="field"><label>Campaign name</label><input id="cn" placeholder="Weekly community bulletin"></div>
    <div class="field"><label>Start from a saved template</label>
      <select id="ct"><option value="">Blank message</option>
        ${tpls.templates.map(t => `<option value="${t.id}">${esc(t.name)}</option>`).join('')}</select></div>
    <div class="field"><label>Message body</label>
      <textarea id="cb" placeholder="Type the message. Placeholders: {{group_name}}, {{campaign_name}}, {{link}}"></textarea></div>
    <div class="field"><label>Link to track (optional)</label>
      <input id="cl" placeholder="https://example.org/bulletin"></div>
    <div class="note" style="margin-bottom:14px">Each group receives its own short link, which is
      what makes click data attributable to an individual group (metric M4).</div>
    <div class="grid g2">
      <div class="field"><label>Target by</label>
        <select id="cmode">
          <option value="filter">Category, folder or tag</option>
          <option value="list">Saved campaign list</option></select></div>
      <div class="field"><label>Channel</label>
        <select id="cch">${chans.channels.map(ch =>
          `<option value="${ch.key}" ${ch.key === chans.active ? 'selected' : ''}>${esc(ch.label)}</option>`).join('')}</select></div>
    </div>
    <div id="filterBox" class="grid g3">
      <div class="field"><label>Category</label><select id="ccat"><option value="">Any</option>
        ${facets.categories.map(x => `<option value="${esc(x.value)}">${esc(x.value)} (${x.count})</option>`).join('')}</select></div>
      <div class="field"><label>Folder</label><select id="cfold"><option value="">Any</option>
        ${facets.folders.map(x => `<option value="${esc(x.value)}">${esc(x.value)} (${x.count})</option>`).join('')}</select></div>
      <div class="field"><label>Tag</label><select id="ctag"><option value="">Any</option>
        ${facets.tags.map(x => `<option value="${esc(x.value)}">${esc(x.value)} (${x.count})</option>`).join('')}</select></div>
    </div>
    <div id="listBox" class="field hidden"><label>Saved list</label>
      <select id="clist">${lists.lists.map(l => `<option value="${l.id}">${esc(l.name)} (${l.count} groups)</option>`).join('')}</select></div>
    <div class="grid g2">
      <div class="field"><label>Schedule (leave blank to save as draft)</label>
        <input id="csched" type="datetime-local"></div>
      <div class="field"><label>Repeat</label>
        <select id="crec"><option value="">Does not repeat</option>
          <option value="hourly">Hourly</option><option value="daily">Daily</option>
          <option value="weekly">Weekly</option></select></div>
    </div>`,
    `<button class="btn" data-x4>Cancel</button>
     <button class="btn primary" id="csave">Create campaign</button>`);

  $('[data-x4]').onclick = closeModal;
  $('#ct').onchange = e => {
    const t = tpls.templates.find(x => x.id == e.target.value);
    if (t) { $('#cb').value = t.body; if (!$('#cn').value) $('#cn').value = t.name; }
  };
  $('#cmode').onchange = e => {
    $('#filterBox').classList.toggle('hidden', e.target.value !== 'filter');
    $('#listBox').classList.toggle('hidden', e.target.value !== 'list');
  };
  $('#csave').onclick = async () => {
    const p = {
      name: $('#cn').value.trim(), body: $('#cb').value,
      link_url: $('#cl').value.trim(), channel: $('#cch').value,
      recurrence: $('#crec').value,
    };
    if ($('#csched').value) p.scheduled_at = $('#csched').value;
    if ($('#cmode').value === 'list') p.list_id = +$('#clist').value;
    else {
      p.category = $('#ccat').value; p.folder = $('#cfold').value; p.tag = $('#ctag').value;
    }
    try {
      const r = await api.post('/api/campaigns', p);
      closeModal();
      toast(`${r.code} created with ${n(r.targets)} targets`);
      openCampaign(r.id);
    } catch (e) { toast(e.message, true); }
  };
}

// ------------------------------------------------------- campaign detail
async function openCampaign(id) {
  S.campaign = id;
  go('campaign');
}

VIEWS.campaign = {
  title: 'Campaign', sub: '',
  async render(c) {
    const id = S.campaign;
    const paint = async () => {
      const [d, a] = await Promise.all([
        api.get('/api/campaigns/' + id),
        api.get(`/api/campaigns/${id}/analytics`)]);
      const cm = d.campaign, m = a.metrics;
      $('#viewTitle').textContent = cm.code + ' · ' + cm.name;
      $('#viewSub').textContent = `${n(cm.targets)} target groups on the ${cm.channel} channel`;

      if (!$('#cdWrap', c)) {
        c.innerHTML = `<div id="cdWrap"></div>`;
      }
      $('#cdWrap', c).innerHTML = `
        <div class="toolbar">
          ${statusPill(cm.status)}
          <div class="spacer"></div>
          ${can('campaign.execute') ? `
            ${['draft', 'scheduled'].includes(cm.status) ? '<button class="btn primary sm" data-act="launch">Launch now</button>' : ''}
            ${cm.status === 'running' ? '<button class="btn sm" data-act="pause">Pause</button>' : ''}
            ${cm.status === 'paused' ? '<button class="btn sm" data-act="resume">Resume</button>' : ''}
            ${['running', 'paused'].includes(cm.status) ? '<button class="btn danger sm" data-act="cancel">Cancel</button>' : ''}
            ${m.M2_failures > 0 ? '<button class="btn sm" data-act="retry-failed">Retry failed</button>' : ''}
            ${['completed', 'partially_failed'].includes(cm.status) ? '<button class="btn sm" data-act="snapshot-now">Force all snapshots</button>' : ''}` : ''}
          ${can('report.export') ? `
            <a class="btn sm" href="/api/reports/campaign/${id}.xlsx">Excel</a>
            <a class="btn sm" href="/api/reports/campaign/${id}.csv">CSV</a>
            <a class="btn sm" href="/api/reports/campaign/${id}.pdf">PDF</a>` : ''}
        </div>

        <div class="grid g4" style="margin-bottom:14px">
          ${tile('M1 groups reached', n(m.M1_groups_reached), pct(m.M1_reach_pct) + ' of targets')}
          ${tile('M9 groups read', n(m.M9_groups_read), pct(m.M9_read_pct_of_reached) + ' of reached')}
          ${tile('M4 link clicks', n(m.M4_clicks), n(m.M4_groups_clicked) + ' groups, CTR ' + pct(m.M4_ctr_pct))}
          ${tile('M2 failures', n(m.M2_failures), pct(m.M2_failure_pct) + ' of targets')}
        </div>

        <div class="grid g21">
          <div class="card">
            <h2>Despatch progression</h2>
            <div class="cap">Sent, delivered and read over the life of the campaign</div>
            <div id="tsChart"><div class="empty">Awaiting despatch</div></div>
          </div>
          <div class="card">
            <h2>Outcome</h2>
            <div class="cap">Status data, labelled</div>
            <div id="stWrap"></div>
            <h2 style="margin-top:16px">Message preview</h2>
            <div class="cap">As one group receives it</div>
            <div class="log" style="max-height:150px;white-space:pre-wrap">${esc(cm.rendered_preview)}</div>
          </div>
        </div>

        <div class="grid g2" style="margin-top:14px">
          <div class="card">
            <h2>Interval snapshots</h2>
            <div class="cap">Immutable at 15 minutes, 1 hour, 3 hours and 8 hours after despatch completes</div>
            <div id="snapChart"></div>
            <div id="snapTbl" style="margin-top:12px"></div>
          </div>
          <div class="card">
            <h2>Operational log</h2>
            <div class="cap">Live event stream</div>
            <div class="log" id="evLog"></div>
          </div>
        </div>

        <div class="card" style="margin-top:14px">
          <h2>Per group delivery log</h2>
          <div class="cap">One row per group: the success and failure record required by FR-15</div>
          <div class="toolbar">
            <select id="dstat"><option value="">All outcomes</option>
              <option value="read">Read</option><option value="delivered">Delivered</option>
              <option value="sent">Sent, awaiting delivery</option>
              <option value="queued">Queued</option><option value="failed">Failed</option></select>
          </div>
          <div id="delivTbl"></div>
        </div>`;

      // charts
      if (a.timeseries && a.timeseries.length) {
        lineChart($('#tsChart', c), {
          labels: a.timeseries.map(p => Math.round(p.offset_sec) + 's'),
          series: [
            { name: 'Sent', values: a.timeseries.map(p => p.sent) },
            { name: 'Delivered', values: a.timeseries.map(p => p.delivered) },
            { name: 'Read', values: a.timeseries.map(p => p.read) }],
          yLabel: 'Groups, cumulative, by seconds since campaign start',
        });
      }
      statusBar($('#stWrap', c), [
        { label: 'Reached', value: m.M1_groups_reached, color: css('--good'), icon: '✓' },
        { label: 'Pending', value: m.M3_pending, color: css('--warning'), icon: '○' },
        { label: 'Failed', value: m.M2_failures, color: css('--critical'), icon: '✕' },
      ]);

      const snaps = a.snapshots;
      if (snaps.length) {
        barChart($('#snapChart', c), {
          groups: snaps.map(s => s.label),
          series: [
            { name: 'Groups read', values: snaps.map(s => s.M9_groups_read || 0) },
            { name: 'Link clicks', values: snaps.map(s => s.M4_clicks || 0) }],
          yLabel: 'Measured at each interval after despatch completed',
        });
      } else {
        $('#snapChart', c).innerHTML = '<div class="empty">Snapshots are taken once despatch completes.</div>';
      }
      $('#snapTbl', c).innerHTML = `<div class="tbl-wrap"><table>
        <thead><tr><th>Interval</th><th>Status</th><th class="num">Reached</th><th class="num">Read</th>
          <th class="num">Clicks</th><th class="num">Replies</th><th class="num">Engagement</th></tr></thead>
        <tbody>${a.schedule.map(sc => {
          const s = snaps.find(x => x.label === sc.label);
          return `<tr><td><strong>${esc(sc.label)}</strong>
            <div style="font-size:10.5px;color:var(--text-muted)">nominal ${sc.nominal_interval_seconds}s &rarr; ${sc.effective_interval_seconds}s here</div></td>
            <td>${sc.taken ? '<span class="pill good">✓ taken</span>' : (sc.due_at ? '<span class="pill warn">◷ due ' + when(sc.due_at) + '</span>' : '<span class="pill">awaiting despatch</span>')}</td>
            <td class="num">${s ? n(s.M1_groups_reached) : '—'}</td>
            <td class="num">${s ? n(s.M9_groups_read) : '—'}</td>
            <td class="num">${s ? n(s.M4_clicks) : '—'}</td>
            <td class="num">${s ? n(s.M6_replies) : '—'}</td>
            <td class="num">${s ? s.M7_engagement_index : '—'}</td></tr>`;
        }).join('')}</tbody></table></div>`;

      $$('[data-act]', c).forEach(b => b.onclick = async () => {
        b.disabled = true;
        try {
          const act = b.dataset.act;
          await api.post(`/api/campaigns/${id}/${act === 'launch' ? 'launch' : act}`);
          toast('Done: ' + act);
        } catch (e) { toast(e.message, true); }
        paint();
      });
      loadDeliveries(id, $('#dstat', c).value);
      $('#dstat', c).onchange = e => loadDeliveries(id, e.target.value);
      loadEvents(id);
    };

    await paint();
    every(2500, async () => {
      const d = await api.get('/api/campaigns/' + S.campaign);
      if (['running', 'paused'].includes(d.campaign.status) || S.pollMore) { paint(); }
      else { loadEvents(S.campaign); refreshSnaps(S.campaign); }
    });
  }
};

async function refreshSnaps(id) {
  try {
    const a = await api.get(`/api/campaigns/${id}/analytics`);
    const el = $('#snapChart');
    if (el && a.snapshots.length) {
      barChart(el, {
        groups: a.snapshots.map(s => s.label),
        series: [
          { name: 'Groups read', values: a.snapshots.map(s => s.M9_groups_read || 0) },
          { name: 'Link clicks', values: a.snapshots.map(s => s.M4_clicks || 0) }],
        yLabel: 'Measured at each interval after despatch completed',
      });
    }
  } catch (e) { /* view changed */ }
}

async function loadDeliveries(id, status) {
  const el = $('#delivTbl');
  if (!el) return;
  const d = await api.get(`/api/campaigns/${id}/deliveries?size=150&status=${status || ''}`);
  el.innerHTML = `<div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px">
      Showing ${d.items.length} of ${n(d.total)}</div>
    <div class="tbl-wrap" style="max-height:420px"><table>
    <thead><tr><th>Group</th><th>Category</th><th class="num">Members</th><th>Outcome</th>
      <th class="num">Attempts</th><th class="num">Member reads</th><th>Error</th><th class="mono">Message id</th></tr></thead>
    <tbody>${d.items.map(r => `<tr>
      <td>${esc(r.group)}</td><td>${esc(r.category)}</td><td class="num">${n(r.members)}</td>
      <td>${deliveryPill(r.status)}</td><td class="num">${r.attempts}</td>
      <td class="num">${r.status === 'read' ? n(r.member_reads) : '—'}</td>
      <td>${r.error_code ? `<span class="pill crit">${r.error_code}</span> ${esc(r.error)}` : '—'}</td>
      <td class="mono">${esc((r.message_id || '—').slice(0, 22))}</td></tr>`).join('')}
    </tbody></table></div>`;
}

const deliveryPill = (s) => ({
  read: '<span class="pill good">✓✓ read</span>',
  delivered: '<span class="pill good">✓ delivered</span>',
  sent: '<span class="pill info">↗ sent</span>',
  queued: '<span class="pill warn">○ queued</span>',
  failed: '<span class="pill crit">✕ failed</span>',
}[s] || `<span class="pill">${esc(s)}</span>`);

async function loadEvents(id) {
  const el = $('#evLog');
  if (!el) return;
  const d = await api.get('/api/events?campaign_id=' + id + '&limit=60');
  el.innerHTML = d.events.map(e =>
    `<div><span class="t">${new Date(e.ts).toLocaleTimeString('en-IN')}</span>
     <span class="${e.level}">${esc(e.message)}</span></div>`).join('') ||
    '<div class="t">No events yet.</div>';
  el.scrollTop = el.scrollHeight;
}

// --------------------------------------------------------------- reports
VIEWS.reports = {
  title: 'Reports', sub: 'Exports in Excel, CSV and PDF',
  async render(c) {
    const d = await api.get('/api/campaigns?size=100');
    c.innerHTML = `
      <div class="card" style="margin-bottom:14px">
        <h2>Master data</h2><div class="cap">The full group register</div>
        <div class="btn-row">
          <a class="btn" href="/api/reports/groups.xlsx">Groups, Excel</a>
          <a class="btn" href="/api/reports/groups.csv">Groups, CSV</a></div>
      </div>
      <div class="card">
        <h2>Campaign reports</h2>
        <div class="cap">Each export carries the summary, the interval snapshots, the per group log and the failure analysis</div>
        <div class="tbl-wrap"><table>
          <thead><tr><th>Code</th><th>Campaign</th><th>Status</th><th class="num">Targets</th><th>Exports</th></tr></thead>
          <tbody>${d.items.length ? d.items.map(r => `<tr>
            <td class="mono">${esc(r.code)}</td><td>${esc(r.name)}</td>
            <td>${statusPill(r.status)}</td><td class="num">${n(r.targets)}</td>
            <td><div class="btn-row">
              <a class="btn sm" href="/api/reports/campaign/${r.id}.xlsx">Excel</a>
              <a class="btn sm" href="/api/reports/campaign/${r.id}.csv">CSV</a>
              <a class="btn sm" href="/api/reports/campaign/${r.id}.pdf">PDF</a></div></td></tr>`).join('')
            : '<tr><td colspan="5" class="empty">No campaigns to report on yet.</td></tr>'}
          </tbody></table></div>
      </div>`;
  }
};

// ----------------------------------------------------------- feasibility
const FEAS = [
  ['M1', 'Groups successfully reached', 'Feasible', 'Feasible',
    'sent and delivered status webhooks; the delivery engine records each group at despatch'],
  ['M2', 'Delivery failures', 'Feasible', 'Feasible',
    'failed status with a numeric error code, error title and detail'],
  ['M3', 'Pending deliveries', 'Feasible', 'Feasible',
    'derived from the gap between a sent and a delivered status. The one metric with no dedicated field'],
  ['M9', 'Read statistics', 'Feasible', 'Feasible, detail confirmed in Week 1',
    'WhatsApp always sends read receipts in group chats. The official API returns a read status aggregated per group'],
  ['M4', 'Link clicks', 'Feasible for template URL buttons', 'Feasible',
    'Template Analytics reports url_button and unique_url_button. Body links are not counted, so the platform issues a tracked short link per group'],
  ['M5', 'Media downloads and views', 'Not available', 'Feasible if delivered as a tracked link',
    'no media metric exists in the template analytics enumeration. A direct attachment reports nothing back'],
  ['M6', 'User interactions', 'Feasible', 'Feasible',
    'replies from group participants trigger webhooks; captured and attributed to the campaign'],
  ['M7', 'Engagement metrics', 'Feasible', 'Feasible',
    'messaging, conversation and template analytics, plus a composite index over collected data'],
  ['M8', 'Custom engagement metrics', 'Feasible', 'Feasible',
    'computed over the platform event store. Definitions agreed at requirement analysis'],
];

VIEWS.feasibility = {
  title: 'Feasibility', sub: 'What this build proves, and what it does not',
  async render(c) {
    let health = {};
    try { health = (await api.get('/api/channels/cloud_api/health')).health; } catch (e) { }
    c.innerHTML = `
      <div class="note crit" style="margin-bottom:14px">
        <strong>Read this first.</strong> The despatch channel in this proof of concept defaults to a
        simulator. It sends nothing. It models the outcome distribution that a Week 1 proof of
        concept would measure for real, so that the queue, the rate governor, the retry path, the
        analytics pipeline and the snapshot engine can be exercised end to end. Every rate in it is
        an assumption, not an observation.
      </div>
      <div class="card" style="margin-bottom:14px">
        <h2>Why the official Groups API cannot serve this network</h2>
        <div class="cap">Constraints published by Meta, read live from the adapter</div>
        <ul style="margin:0;padding-left:18px;font-size:12.5px;color:var(--text-secondary);line-height:1.8">
          ${(health.constraints || ['Adapter not reachable']).map(x => `<li>${esc(x)}</li>`).join('')}
        </ul>
        <div class="note" style="margin-top:12px">The conclusion is unchanged from the proposal:
          existing groups cannot be adopted and eight participants per group could not carry this
          network even if they were rebuilt. The reasoning, however, is that the Groups API
          <strong>exists</strong> and is constrained, not that group messaging is impossible.</div>
      </div>
      <div class="card">
        <h2>Metric by metric</h2>
        <div class="cap">Identifiers match the feasibility table in the proposal and the report exports</div>
        <div class="tbl-wrap"><table>
          <thead><tr><th>Id</th><th>Requested metric</th><th>Official Groups API</th>
            <th>This platform</th><th>Basis</th></tr></thead>
          <tbody>${FEAS.map(r => `<tr>
            <td class="mono"><strong>${r[0]}</strong></td><td>${esc(r[1])}</td>
            <td>${r[2].startsWith('Not') ? '<span class="pill crit">✕ ' + esc(r[2]) + '</span>' : '<span class="pill good">✓ ' + esc(r[2]) + '</span>'}</td>
            <td>${r[3].startsWith('Not') ? '<span class="pill crit">✕ ' + esc(r[3]) + '</span>' : '<span class="pill good">✓ ' + esc(r[3]) + '</span>'}</td>
            <td style="color:var(--text-secondary)">${esc(r[4])}</td></tr>`).join('')}
          </tbody></table></div>
      </div>`;
  }
};

// -------------------------------------------------------------- channels
VIEWS.channels = {
  title: 'Channels', sub: 'Despatch routes and their readiness',
  async render(c) {
    const chans = await api.get('/api/channels');
    c.innerHTML = `<div class="grid g3" id="chWrap"></div>`;
    for (const ch of chans.channels) {
      const h = (await api.get(`/api/channels/${ch.key}/health`)).health;
      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div style="display:flex;align-items:flex-start;gap:8px">
          <div style="flex:1"><h2>${esc(ch.key)}</h2>
            <div class="cap">${esc(ch.label)}</div></div>
          ${h.ready ? '<span class="pill good">✓ ready</span>' : '<span class="pill warn">○ not ready</span>'}
        </div>
        <dl class="kv" style="margin-bottom:10px">
          <dt>Sends real messages</dt><dd>${h.sends_real_messages ? '<strong>Yes</strong>' : 'No, simulated'}</dd>
          <dt>Existing groups</dt><dd>${ch.can_address_existing_groups ? 'Can address' : '<strong>Cannot address</strong>'}</dd>
        </dl>
        ${(h.constraints || []).length ? `<div class="note warn"><strong>Constraints</strong><ul style="margin:6px 0 0;padding-left:16px">${h.constraints.map(x => `<li>${esc(x)}</li>`).join('')}</ul></div>` : ''}
        ${(h.warnings || []).length ? `<div class="note crit" style="margin-top:8px"><strong>Warnings</strong><ul style="margin:6px 0 0;padding-left:16px">${h.warnings.map(x => `<li>${esc(x)}</li>`).join('')}</ul></div>` : ''}
        ${(h.notes || []).length ? `<div class="note" style="margin-top:8px">${h.notes.map(esc).join('<br>')}</div>` : ''}
        ${ch.can_address_existing_groups && ch.key !== 'simulator' && can('group.write')
          ? `<div class="btn-row" style="margin-top:10px"><button class="btn sm" data-imp="${ch.key}">Import groups from this channel</button></div>` : ''}`;
      $('#chWrap', c).appendChild(el);
    }
    $$('[data-imp]', c).forEach(b => b.onclick = async () => {
      b.disabled = true; b.textContent = 'Importing…';
      try {
        const r = await api.post(`/api/channels/${b.dataset.imp}/import-groups`);
        toast(`Discovered ${r.discovered}, added ${r.added}`);
      } catch (e) { toast(e.message, true); }
      b.disabled = false; b.textContent = 'Import groups from this channel';
    });
  }
};

// ----------------------------------------------------------------- users
VIEWS.users = {
  title: 'Users', sub: 'Role based access control',
  async render(c) {
    const d = await api.get('/api/users');
    c.innerHTML = `
      <div class="toolbar"><div class="spacer"></div>
        ${can('user.write') ? '<button class="btn primary" id="nu">Add user</button>' : ''}</div>
      <div class="card" style="margin-bottom:14px"><div class="tbl-wrap"><table>
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>State</th><th>Last sign in</th><th></th></tr></thead>
        <tbody>${d.users.map(u => `<tr><td>${esc(u.name)}</td><td class="mono">${esc(u.email)}</td>
          <td><span class="pill info">${esc(u.role.replace(/_/g, ' '))}</span></td>
          <td>${u.active ? '<span class="pill good">✓ active</span>' : '<span class="pill crit">✕ disabled</span>'}</td>
          <td class="nowrap">${when(u.last_login)}</td>
          <td class="right">${can('user.write') ? `<button class="btn sm" data-tog="${u.id}" data-on="${u.active}">${u.active ? 'Disable' : 'Enable'}</button>` : ''}</td></tr>`).join('')}
        </tbody></table></div></div>
      <div class="card"><h2>Permission matrix</h2>
        <div class="cap">Every route declares a permission; the matrix decides. Denials are written to the audit trail.</div>
        <div class="tbl-wrap"><table><thead><tr><th>Permission</th>
          ${d.roles.map(r => `<th>${esc(r.replace(/_/g, ' '))}</th>`).join('')}</tr></thead>
          <tbody>${[...new Set(Object.values(d.permissions).flat())].sort().map(p =>
            `<tr><td class="mono">${esc(p)}</td>${d.roles.map(r =>
              `<td>${d.permissions[r].includes(p) ? '<span style="color:var(--good);font-weight:700">✓</span>' : '<span style="color:var(--text-muted)">—</span>'}</td>`).join('')}</tr>`).join('')}
          </tbody></table></div></div>`;
    $$('[data-tog]', c).forEach(b => b.onclick = async () => {
      await api.patch('/api/users/' + b.dataset.tog, { active: b.dataset.on !== 'true' });
      go('users');
    });
    const nu = $('#nu', c);
    if (nu) nu.onclick = () => {
      modal('Add user', `
        <div class="field"><label>Name</label><input id="un"></div>
        <div class="field"><label>Email</label><input id="ue" type="email"></div>
        <div class="field"><label>Password</label><input id="up" type="password"></div>
        <div class="field"><label>Role</label><select id="ur">
          ${d.roles.map(r => `<option value="${r}">${esc(r.replace(/_/g, ' '))}</option>`).join('')}</select></div>`,
        `<button class="btn" data-x5>Cancel</button><button class="btn primary" id="usave">Create</button>`);
      $('[data-x5]').onclick = closeModal;
      $('#usave').onclick = async () => {
        try {
          await api.post('/api/users', {
            name: $('#un').value, email: $('#ue').value,
            password: $('#up').value, role: $('#ur').value
          });
          closeModal(); toast('User created'); go('users');
        } catch (e) { toast(e.message, true); }
      };
    };
  }
};

// ----------------------------------------------------------------- audit
VIEWS.audit = {
  title: 'Audit trail', sub: 'User actions, campaign changes and administrative events',
  async render(c) {
    const d = await api.get('/api/audit?limit=300');
    c.innerHTML = `<div class="card"><div class="tbl-wrap" style="max-height:74vh"><table>
      <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Detail</th><th>IP</th></tr></thead>
      <tbody>${d.entries.map(a => `<tr><td class="nowrap">${when(a.ts)}</td>
        <td class="mono">${esc(a.actor)}</td>
        <td><span class="pill ${a.action.includes('denied') || a.action.includes('failed') ? 'crit' : ''}">${esc(a.action)}</span></td>
        <td>${esc(a.entity)}${a.entity_id ? ' #' + esc(a.entity_id) : ''}</td>
        <td style="color:var(--text-secondary)">${esc(a.detail)}</td>
        <td class="mono">${esc(a.ip)}</td></tr>`).join('')}
      </tbody></table></div></div>`;
  }
};

// --------------------------------------------------------------- routing
async function go(view) {
  clearTimers();
  S.view = view;
  $$('.nav-item').forEach(b => b.classList.toggle('active', b.dataset.view === view));
  const v = VIEWS[view];
  if (!v) return;
  $('#viewTitle').textContent = v.title;
  $('#viewSub').textContent = v.sub || '';
  const c = $('#content');
  c.innerHTML = '<div class="empty"><span class="spin"></span></div>';
  try { await v.render(c); }
  catch (e) { c.innerHTML = `<div class="card"><div class="err">${esc(e.message)}</div></div>`; }
}

$$('.nav-item').forEach(b => b.onclick = () => go(b.dataset.view));

$('#themeBtn').onclick = () => {
  const cur = document.documentElement.getAttribute('data-theme');
  const next = cur === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('wdap-theme', next);
  go(S.view);
};
try {
  const t = localStorage.getItem('wdap-theme');
  if (t) document.documentElement.setAttribute('data-theme', t);
} catch (e) { }

$('#logoutBtn').onclick = async () => { await api.post('/api/auth/logout'); showLogin(); };

function showLogin() {
  clearTimers();
  $('#app').classList.remove('on');
  $('#login').style.display = 'grid';
}

async function boot() {
  try {
    const me = await api.get('/api/auth/me');
    S.user = me.user;
    S.sys = await api.get('/api/system');
  } catch (e) { return showLogin(); }
  $('#login').style.display = 'none';
  $('#app').classList.add('on');
  $('#whoName').textContent = S.user.name;
  $('#whoRole').textContent = S.user.role.replace(/_/g, ' ');
  $('#channelPill').textContent = 'channel: ' + S.sys.default_channel;
  $('#scalePill').textContent = 'interval scale ×' + S.sys.time_scale;
  $('#scalePill').title =
    'Snapshot intervals are compressed so a demonstration is observable: ' +
    S.sys.snapshot_intervals.map(i => `${i.label} -> ${i.effective_seconds}s`).join(', ');
  go('dashboard');
}

$('#loginForm').onsubmit = async (e) => {
  e.preventDefault();
  const err = $('#loginErr');
  err.classList.add('hidden');
  try {
    await api.post('/api/auth/login', {
      email: $('#email').value, password: $('#password').value
    });
    boot();
  } catch (ex) {
    err.textContent = ex.message; err.classList.remove('hidden');
  }
};

boot();
